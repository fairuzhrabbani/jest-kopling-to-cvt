{
  "name": "backend-api-store-jest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:auth": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/auth",
    "test:login": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/auth/login_allure.test.js",
    "test:register": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/auth/register_allure.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "allure:clean": "rimraf allure-results allure-report",
    "allure:generate": "allure generate ./allure-results",
    "allure:open": "allure open ./allure-report",
    "test:login:report": "npm run allure:clean && npm run test:login && npm run allure:generate && npm run allure:open",
    "test:register:report": "npm run allure:clean && npm run test:register && npm run allure:generate && npm run allure:open",
    "test:login:reportfirst": "node scripts/test-login-report.js"
  },
  "keywords": [],
  "author": "Fairuz Hanif Rabbani",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "allure": "^3.16.0",
    "allure-jest": "^3.12.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
